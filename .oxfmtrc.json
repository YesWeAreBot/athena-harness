{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".omp/**",
    ".specify/**",
    "tools/oxlint/anti-slop/**",
    "**/dist/**",
    "**/lib/**",
    "**/node_modules/**",
    "legacy/**",
    "vendor/**"
  ],
  "sortImports": {
    "newlinesBetween": true
  },
  "sortPackageJson": {
    "sortDependencies": true,
    "sortDevDependencies": true,
    "sortPeerDependencies": true,
    "sortScripts": true
  },
  "endOfLine": "lf",
  "semi": true,
  "printWidth": 160,
  "objectWrap": "preserve",
  "singleQuote": false,
  "insertFinalNewline": true,
  "trailingComma": "all"
}
