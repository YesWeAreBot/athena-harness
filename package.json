{
  "name": "@yesimbot/athena-harness",
  "version": "0.0.0",
  "private": true,
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./persist/jsonl": {
      "types": "./lib/persist/jsonl.d.ts",
      "default": "./lib/persist/jsonl.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ai": "^7.0.0",
    "cordis": "^4.0.0-rc.8",
    "cosmokit": "^1.8.1",
    "schemastery": "^3.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@4.12.0"
}
