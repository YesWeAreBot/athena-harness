{
  "name": "athena-harness",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yakumo build",
    "clean": "yakumo clean",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "husky",
    "test": "yakumo vitest"
  },
  "devDependencies": {
    "@cordisjs/client": "^0.8.2",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "^22.20.1",
    "bumpp": "^12.2.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "yakumo": "^3.2.1",
    "yakumo-esbuild": "^3.0.2",
    "yakumo-tsc": "^3.0.1",
    "yakumo-vitest": "^1.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
