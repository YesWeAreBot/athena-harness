{
  "name": "athena-harness",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/*/*",
    "vendor/*/*"
  ],
  "type": "module",
  "scripts": {
    "build": "yakumo build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:check": "oxlint --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "bumpp": "^12.2.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "yakumo": "^3.2.0",
    "yakumo-esbuild": "^3.0.0",
    "yakumo-tsc": "^3.0.0",
    "yakumo-vitest": "^1.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs,js,jsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.json": [
      "oxfmt --write"
    ]
  },
  "packageManager": "yarn@4.12.0"
}
