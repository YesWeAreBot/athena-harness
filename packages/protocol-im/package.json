{
  "name": "@athena-ai/protocol-im",
  "version": "0.1.0",
  "description": "IM protocol layer for Athena Nerve — types, Body method extensions, events, MessageEncoder, WsClient",
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@athena-ai/protocol": "workspace:*",
    "@cordisjs/element": "^0.3.0",
    "cosmokit": "^1.8.1"
  },
  "devDependencies": {
    "@cordisjs/plugin-http": "^1.3.0",
    "cordis": "^4.0.0-rc.8"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.8"
  }
}
