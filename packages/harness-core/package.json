{
  "name": "@yesimbot/harness-core",
  "version": "0.0.0",
  "private": true,
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./persist/jsonl": {
      "types": "./lib/persist/jsonl.d.ts",
      "default": "./lib/persist/jsonl.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "lint": "oxlint src test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ai": "^7.0.0",
    "cordis": "^4.0.0-rc.8",
    "cosmokit": "^1.8.1",
    "schemastery": "^3.18.0",
    "zod": "^3.25.76"
  }
}
